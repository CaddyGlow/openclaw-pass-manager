{
  "name": "openclaw-pass-manager",
  "version": "1.0.0",
  "description": "OpenClaw plugin for the standard Unix password manager (pass). Provides agent tools to list, get, save, search passwords and generate OTP codes.",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "pass",
    "password-store",
    "password-manager",
    "otp",
    "totp",
    "gpg"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "install": {
      "npmSpec": "openclaw-pass-manager"
    }
  },
  "files": [
    "src/",
    "openclaw.plugin.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
